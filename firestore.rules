rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Settings (branding, hero, history, culture, organization, tickets, contact, theme, arts)
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // News
    match /news/{newsId} {
      allow read, write: if true;
    }

    // Attractions
    match /attractions/{attractionId} {
      allow read, write: if true;
    }

    // Arts
    match /arts/{artId} {
      allow read, write: if true;
    }

    // Museums
    match /museums/{museumId} {
      allow read, write: if true;
    }

    // NavItems
    match /navItems/{navItemId} {
      allow read, write: if true;
    }

    // SocialLinks
    match /socialLinks/{socialLinkId} {
      allow read, write: if true;
    }

    // ExternalLinks
    match /externalLinks/{externalLinkId} {
      allow read, write: if true;
    }

    // Users
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
